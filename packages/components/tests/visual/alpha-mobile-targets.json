{
  "viewports": [
    {
      "name": "narrow-desktop",
      "width": 390,
      "height": 1000
    },
    {
      "name": "boundary320",
      "width": 320,
      "height": 900
    },
    {
      "name": "iphone",
      "device": "iPhone 13",
      "width": 390,
      "height": 1000
    },
    {
      "name": "android",
      "device": "Pixel 5",
      "width": 393,
      "height": 1000
    }
  ],
  "themes": ["light", "dark"],
  "ids": [
    "mobile-alphamobilemigration--tabs-all-states",
    "mobile-alphamobilemigration--tabs-compact",
    "mobile-alphamobilemigration--tabs-empty",
    "mobile-alphamobilemigration--tabs-read-only",
    "mobile-alphamobilemigration--removal-default",
    "mobile-alphamobilemigration--removal-offline",
    "mobile-alphamobilemigration--removal-empty",
    "mobile-alphamobilemigration--removal-error",
    "mobile-alphamobilemigration--removal-pending",
    "mobile-alphamobilemigration--removal-in-flight",
    "mobile-alphamobilemigration--removal-long"
  ],
  "ready": {
    "mobile-alphamobilemigration--tabs-all-states": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--tabs-compact": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--tabs-empty": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--tabs-read-only": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--removal-default": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--removal-offline": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--removal-empty": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--removal-error": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--removal-pending": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--removal-in-flight": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ],
    "mobile-alphamobilemigration--removal-long": [
      {
        "action": "visible",
        "selector": "[role=dialog]"
      }
    ]
  },
  "states": {
    "mobile-alphamobilemigration--tabs-all-states": [
      {
        "name": "closed-list",
        "steps": [
          {
            "action": "click",
            "selector": "button[aria-expanded]"
          },
          {
            "action": "visible",
            "text": "Closed synthetic conversation",
            "exact": false
          }
        ]
      },
      {
        "name": "idle-hover",
        "steps": [
          {
            "action": "hover",
            "selector": "button[aria-current=\"false\"]",
            "index": 0
          }
        ]
      },
      {
        "name": "idle-keyboard-focus",
        "steps": [
          {
            "action": "focus",
            "selector": "button[aria-current=\"false\"]",
            "index": 0
          },
          {
            "action": "press",
            "selector": "button[aria-current=\"false\"]",
            "index": 0,
            "key": "ArrowLeft"
          },
          {
            "action": "movePointer",
            "x": -10,
            "y": -10
          }
        ]
      },
      {
        "name": "close-idle-keeps-sheet",
        "steps": [
          {
            "action": "click",
            "selector": "button[aria-label=\"Close\"]",
            "index": 1
          },
          {
            "action": "visible",
            "text": "Closed: idle"
          },
          {
            "action": "visible",
            "selector": "[role=dialog]"
          }
        ]
      }
    ],
    "mobile-alphamobilemigration--tabs-compact": [
      {
        "name": "closed-list",
        "steps": [
          {
            "action": "click",
            "selector": "button[aria-expanded]"
          },
          {
            "action": "visible",
            "text": "Closed synthetic conversation",
            "exact": false
          }
        ]
      },
      {
        "name": "idle-hover",
        "steps": [
          {
            "action": "hover",
            "selector": "button[aria-current=\"false\"]",
            "index": 0
          }
        ]
      }
    ],
    "mobile-alphamobilemigration--removal-default": [
      {
        "name": "preflight-results",
        "steps": [
          {
            "action": "click",
            "selector": "[role=checkbox]"
          },
          {
            "action": "visible",
            "text": "1 worktree has changes and will stay on disk: Dirty synthetic worktree 中文"
          }
        ]
      }
    ],
    "mobile-alphamobilemigration--removal-long": [
      {
        "name": "preflight-results",
        "steps": [
          {
            "action": "click",
            "selector": "[role=checkbox]"
          },
          {
            "action": "visible",
            "text": "1 worktree has changes and will stay on disk: Dirty synthetic worktree 中文"
          }
        ]
      }
    ],
    "mobile-alphamobilemigration--removal-error": [
      {
        "name": "preflight-error",
        "steps": [
          {
            "action": "click",
            "selector": "[role=checkbox]"
          },
          {
            "action": "visible",
            "text": "Synthetic inspection error"
          }
        ]
      }
    ],
    "mobile-alphamobilemigration--removal-pending": [
      {
        "name": "preflight-pending",
        "steps": [
          {
            "action": "click",
            "selector": "[role=checkbox]"
          },
          {
            "action": "visible",
            "text": "Checking each worktree for changes…"
          },
          {
            "action": "disabled",
            "role": "button",
            "name": "Remove project"
          }
        ]
      }
    ],
    "mobile-alphamobilemigration--removal-in-flight": [
      {
        "name": "removal-pending",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Remove project"
          },
          {
            "action": "visible",
            "text": "Processing..."
          },
          {
            "action": "disabled",
            "role": "button",
            "name": "Cancel"
          }
        ]
      }
    ]
  }
}
